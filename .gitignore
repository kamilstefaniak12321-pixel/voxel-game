# Pliki, których git ma NIE zapisywać.

# Pliki systemowe Windowsa i macOS
Thumbs.db
desktop.ini
.DS_Store

# Ustawienia edytorów
.vscode/
.idea/

# Spakowane wersje gry - historia jest teraz w gicie
*.zip

# Biblioteki pobierane przez npm (gdyby kiedyś doszły)
node_modules/

# Zbudowane instalatory aplikacji (npm run dist) - trafiają do wydań,
# nie do gita
dist/

# Aplikacja na telefon: pliki gry kopiowane przed budowaniem
# (npm run android:www) - powstają od nowa przy każdym budowaniu
www/
